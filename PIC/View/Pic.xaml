<UserControl x:Class="PIC.View.Pic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PIC.View"
             xmlns:vm="clr-namespace:PIC.ViewModel"
             xmlns:Menu="clr-namespace:PIC.Utilities"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid>
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- APARTAT DELS BOTONS I SECCIONS DELS RESULTATS -->
            <Grid Grid.Row="0" 
                  Background="{StaticResource MigFosc}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="{StaticResource Fosc}">
                    
                    <TextBlock FontSize="12" 
                               VerticalAlignment="Center"
                               Text="{Binding TextCerca}"
                               Style="{StaticResource Fraktion_Light_Font}" 
                               Margin="10, 0, 10, 0"/>
                </Grid>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="10">

                </StackPanel>
            </Grid>

            <!-- APARTAT RESULTATS -->
            <Grid Grid.Row="1" 
                  Background="{StaticResource Clar}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ADMINISTRADORS -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER ADMINISTRADORS -->
                        <Grid Grid.Row="0"
                              Background="{StaticResource MigClar}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="10, 0, 0, 0" VerticalAlignment="Center">
                                <TextBlock FontSize="12" Style="{StaticResource Fraktion_Dark_Font}">ID</TextBlock>
                            </Grid>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="12" Style="{StaticResource Fraktion_Dark_Font}">NOM</TextBlock>
                            </Grid>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock FontSize="12" Style="{StaticResource Fraktion_Dark_Font}">PERMISOS</TextBlock>
                            </Grid>
                        </Grid>

                        <!-- LLISTAT ADMINISTRADORS -->
                        <Grid Grid.Row="2">
                            <ListView ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ItemsSource="{Binding Administradors}"
                                      SelectedItem="{Binding AdministradorSeleccionat, Mode=TwoWay}"
                                      Style="{StaticResource ListViewStyle}"
                                      ItemContainerStyle="{StaticResource ListViewStyleItem}">

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock FontSize="12" 
                                                       Grid.Column="0" 
                                                       Text="{Binding Id}" 
                                                       Style="{StaticResource Fraktion_Dark_Font}"
                                                       Margin="10,0,0,0"/>

                                            <TextBlock FontSize="12" 
                                                       Grid.Column="1" 
                                                       Text="{Binding Nom}"
                                                       Style="{StaticResource Fraktion_Dark_Font}"/>
                                            
                                            <TextBlock FontSize="12" 
                                                       Grid.Column="2" 
                                                       Text="{Binding Permisos}"
                                                       Style="{StaticResource Fraktion_Dark_Font}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                    <!-- ADMINISTRADORS -->
                    <Grid Grid.Column="1"
                          Background="{StaticResource MigClar}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    Margin="0, 40, 0, 0">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Accions:"
                                           Grid.Row="0"
                                           Width="200"
                                           VerticalAlignment="Bottom"
                                           Style="{StaticResource Fraktion_Dark_Font}"/>
                                
                                <Button Content="AFEGIR ADMINISTRADOR"
                                        Grid.Row="2"
                                        Width="200"
                                        Style="{StaticResource Accions_Button}"
                                        Command="{Binding AfegirAdministradorMenu_Click}"/>

                                <Button Content="EDITAR ADMINISTRADOR"
                                        Grid.Row="4"
                                        Width="200"
                                        Style="{StaticResource Accions_Button}"
                                        Command="{Binding EditarAdministradorMenu_Click}"/>

                                <Button Content="ESBORRAR ADMINISTRADOR"
                                        Grid.Row="6"
                                        Width="200"
                                        Style="{StaticResource Accions_Button}"
                                        Command="{Binding EsborrarAdministradorMenu_Click}"/>

                                <TextBlock Text="Opcions PIC:"
                                           Grid.Row="8"
                                           Width="200"
                                           VerticalAlignment="Bottom"
                                           Style="{StaticResource Fraktion_Dark_Font}"/>

                                <Button Content="COMENÇAR NOU CURS"
                                        Grid.Row="10"
                                        Width="200"
                                        Style="{StaticResource Accions_Button}"
                                        Command="{Binding FinalitzarCursMenu_Click}"/>

                                <Button Content="EXPORTAR REGISTRES"
                                        Grid.Row="12"
                                        Width="200"
                                        Style="{StaticResource Accions_Button}"
                                        Command="{Binding ExportarRegistresMenu_Click}"/>
                                
                                <Button Content="REPARAR SISTEMA"
                                        Grid.Row="14"
                                        Width="200"
                                        Style="{StaticResource Accions_Button}"
                                        Command="{Binding RepararSistema_Click}"/>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Column="1"
                              Margin="0, 40, 40, 20">
                            
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- EXPLICACIO ROL 1 -->
                            <StackPanel Grid.Row="0">
                                <TextBlock Style="{StaticResource Fraktion_Dark_Font}"
                                           Margin="0, 0, 0, 10">
                                    Administrador:
                                </TextBlock>
                                
                                <TextBlock Style="{StaticResource Fraktion_Dark_Font}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Justify"
                                           Margin="0, 0, 0, 30">
                                    Un usuari amb els permisos d'Administrador té control total del sistema, pot accedir a qualsevol apartat i 
                                    interactuar amb tots els apartats.
                                </TextBlock>
                            </StackPanel>

                            <!-- EXPLICACIO ROL 2 -->
                            <StackPanel Grid.Row="1">
                                <TextBlock Style="{StaticResource Fraktion_Dark_Font}"
                                           Margin="0, 0, 0, 10">
                                    Préstecs:
                                </TextBlock>
                                
                                <TextBlock Style="{StaticResource Fraktion_Dark_Font}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Justify"
                                           Margin="0, 0, 0, 30">
                                    Un usuari amb els permisos de Préstecs només pot actuar sobre l'apartat Préstecs, creant i modificant els 
                                    préstecs que vulgui. Pot consultar tots els apartats (menys aquest) peró no pot modificar els elements
                                    de l'apartat en el que es trobi
                                </TextBlock>
                            </StackPanel>

                            <!-- EXPLICACIO ROL 3 -->
                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource Fraktion_Dark_Font}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Justify">
                                    En cas de dubte, contactar amb un/a responsable.
                                </TextBlock>
                            </StackPanel>                            
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        
        <local:MissatgeError DataContext="{Binding MissatgeError}" d:IsHidden="true"/>
        <local:AfegirAdministrador DataContext="{Binding AfegirAdministrador}" d:IsHidden="true"/>
        <local:EditarAdministrador DataContext="{Binding EditarAdministrador}" d:IsHidden="true"/>
        <local:ConfirmarEsborrar DataContext="{Binding ConfirmarEsborrar}" d:IsHidden="true"/>
        <local:RepararSistema DataContext="{Binding RepararSistema}" d:IsHidden="true"/>
        <local:FinalitzarCurs DataContext="{Binding FinalitzarCurs}" d:IsHidden="true"/>
        <local:ExportarRegistres DataContext="{Binding ExportarRegistres}" d:IsHidden="true"/>
        <local:Notificacio DataContext="{Binding Notificacio}" d:IsHidden="true"/>
    </Grid>
</UserControl>
